{
  "name": "javascript-action",
  "description": "GitHub Actions JavaScript Template",
  "version": "0.0.0",
  "author": "",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/actions/javascript-action#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/javascript-action.git"
  },
  "bugs": {
    "url": "https://github.com/actions/javascript-action/issues"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=26.0"
  },
  "scripts": {
    "bundle": "pnpm run format && pnpm run package",
    "ci-test": "vitest run",
    "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
    "format:check": "oxfmt --ignore-path=.oxfmtignore --check .",
    "lint": "oxlint --config=.oxlintrc.json .",
    "package": "ncc build src/index.js -o dist --source-map --license licenses.txt",
    "package:watch": "pnpm run package --watch",
    "test": "vitest run",
    "all": "pnpm run format && pnpm run lint && pnpm run test && pnpm run coverage && pnpm run package",
    "lint:fix": "oxfmt --ignore-path=.oxfmtignore . && oxlint --config=.oxlintrc.json --fix .",
    "format": "oxfmt --ignore-path=.oxfmtignore ."
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.44.1",
    "@vitest/coverage-v8": "^4.0.15",
    "make-coverage-badge": "^1.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@11.20.0"
}
